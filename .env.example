# Copy this file to .env and fill in your own values. Never commit .env.

# Required: Tavily web search key (https://app.tavily.com)
TAVILY_API_KEY=your_tavily_api_key_here

# Required: Gemini key (https://aistudio.google.com/apikey) and model name
LLM_API_KEY=your_gemini_api_key_here
LLM_MODEL=gemini-3-flash-preview

# Optional: Groq key (https://console.groq.com/keys) for the fallback LLM. It is used only when
# Gemini fails with a rate limit or quota error, a temporary server error or a timeout. Leave it
# commented out to use Gemini only.
# GROQ_API_KEY=your_groq_api_key_here

# Optional
BACKEND_URL=http://localhost:8000
LLM_TIMEOUT_S=30
SEARCH_TIMEOUT_S=30

# Optional: analysis limits (bad or non-positive values fall back to these defaults)
COMPETITOR_MAX_EXTRA_QUERIES=5
COMPETITOR_RESULTS_PER_QUERY=3
EVIDENCE_MAX_ITEMS=12
PIPELINE_TIMEOUT_S=180

# Optional: the new web interface (KIRO_UI_UPGRADE_SPEC.md Section 10). Comma-separated browser
# origins allowed to call the API; a wildcard is never accepted. Default: the Vite dev server.
# CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# Seconds a background run (POST /api/runs) may take. Unset keeps 90% of PIPELINE_TIMEOUT_S.
# PIPELINE_TIME_LIMIT_S=162
# Where the local run history is kept. A relative path is read from the project folder.
# RUNS_DB_PATH=data/runs.db

# Optional: Milestone 3 strategy and Advisor limits (MILESTONE_3_MASTER_IMPLEMENTATION_PLAN.md
# Section 12.6). A bad or out-of-range value falls back to the default shown.
# Extra seconds for the strategy stages of a run that includes strategy (30 to 900).
# STRATEGY_TIME_LIMIT_S=150
# Character cap of the findings digest sent to the strategy stages (4000 to 100000).
# STRATEGY_DIGEST_MAX_CHARS=24000
# Advisor questions per validation (1 to 100).
# CHAT_MAX_USER_TURNS=25
# Characters per Advisor question (100 to 4000).
# CHAT_MAX_MESSAGE_CHARS=1000
# Earlier question-and-answer exchanges sent with each question (1 to 20).
# CHAT_HISTORY_TURNS=6
# Character cap of the validation context sent with each question (4000 to 120000).
# CHAT_CONTEXT_MAX_CHARS=30000
# Advisor questions answered at the same time across all validations (1 to 8).
# CHAT_MAX_CONCURRENT=2
# Seconds to wait between two questions on one validation (0 to 60).
# CHAT_COOLDOWN_S=2
