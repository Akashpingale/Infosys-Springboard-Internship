# Copy this file to .env and fill in your own values. Never commit .env.

# Required: Tavily web search key (https://app.tavily.com)
TAVILY_API_KEY=your_tavily_api_key_here

# Required: Gemini key (https://aistudio.google.com/apikey) and model name
LLM_API_KEY=your_gemini_api_key_here
LLM_MODEL=gemini-3-flash-preview

# Optional: Groq key (https://console.groq.com/keys) for the fallback LLM. It is used only when
# Gemini fails with a rate limit or quota error, a temporary server error or a timeout. Leave it
# commented out to use Gemini only.
# GROQ_API_KEY=your_groq_api_key_here

# Optional
BACKEND_URL=http://localhost:8000
LLM_TIMEOUT_S=30
SEARCH_TIMEOUT_S=30

# Optional: analysis limits (bad or non-positive values fall back to these defaults)
COMPETITOR_MAX_EXTRA_QUERIES=5
COMPETITOR_RESULTS_PER_QUERY=3
EVIDENCE_MAX_ITEMS=12
PIPELINE_TIMEOUT_S=180

# Optional: the new web interface (KIRO_UI_UPGRADE_SPEC.md Section 10). Comma-separated browser
# origins allowed to call the API; a wildcard is never accepted. Default: the Vite dev server.
# CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# Seconds a background run (POST /api/runs) may take. Unset keeps 90% of PIPELINE_TIMEOUT_S.
# PIPELINE_TIME_LIMIT_S=162
# Where the local run history is kept. A relative path is read from the project folder.
# RUNS_DB_PATH=data/runs.db
