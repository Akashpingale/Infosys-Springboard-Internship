    "body": {
      "app_name": "AI Startup Idea Validator",
      "examples": [
        {
          "key": "agritech",
          "label": "Agritech",
          "submission": {
            "idea_description": "A mobile app that detects crop diseases from a photo of a leaf and suggests a treatment. Small farmers get an instant diagnosis in their own language instead of waiting for an expert visit.",
            "industry": "Agriculture / AgriTech",
            "relevant_details": "Pilot planned in Maharashtra with two farming cooperatives. Pre-seed stage, no funding yet.",
            "target_customers": "Small farmers in India"
          }
        },
        {
          "key": "fintech_cashflow",
          "label": "Fintech",
          "submission": {
            "idea_description": "A cash-flow and expense management platform for small businesses. It reads bank and UPI statements with consent, sorts every expense into categories, and shows the owner how much cash is left and which bills fall due next. Owners who track this in spreadsheets today get a weekly forecast instead.",
            "industry": "Finance / FinTech",
            "relevant_details": "Pilot planned with twelve shops in Pune. We know Khatabook is used widely for ledgers.",
            "target_customers": "Small business owners in Indian cities"
          }
        },
        {
          "key": "foodtech_surplus",
          "label": "Foodtech",
          "submission": {
            "idea_description": "A surplus food marketplace that cuts food waste. Restaurants and grocery stores list unsold stock at a discount each evening, and nearby shoppers collect it before closing. Listings expire automatically so nothing unsafe is offered, and each shop sees how much waste it avoided.",
            "industry": "Food & Beverage",
            "relevant_details": "Starting with two neighbourhoods in Bengaluru. Shops told us they discard unsold stock nightly.",
            "target_customers": "Restaurants and grocery stores in Indian cities"
          }
        }
      ],
