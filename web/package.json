{
  "name": "startup-idea-validator-web",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "New web interface for the AI Startup Idea Validator (KIRO_UI_UPGRADE_SPEC.md).",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit && tsc --noEmit -p e2e/tsconfig.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "test:e2e:a11y": "playwright test accessibility",
    "test:shots": "playwright test screenshots",
    "api:types": "openapi-typescript http://127.0.0.1:8000/openapi.json -o src/api/types.gen.ts"
  },
  "dependencies": {
    "@fontsource/ibm-plex-mono": "5.3.0",
    "@fontsource/ibm-plex-sans": "5.3.0",
    "@fontsource/ibm-plex-sans-condensed": "5.3.0",
    "@hookform/resolvers": "6.0.2",
    "@radix-ui/react-label": "2.1.17",
    "@radix-ui/react-popover": "1.3.1",
    "@radix-ui/react-slot": "1.5.0",
    "@tanstack/react-query": "5.105.0",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "cmdk": "1.1.1",
    "lucide-react": "1.64.0",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "react-hook-form": "7.91.0",
    "react-router-dom": "6.30.6",
    "recharts": "2.15.4",
    "sonner": "2.0.8",
    "tailwind-merge": "2.6.1",
    "zod": "3.25.76"
  },
  "comments": {
    "overrides": "@axe-core/playwright pulls its own newer playwright-core, which npm hoists above the one @playwright/test uses. Two copies disagree about which browser build to download, so the runner looked for a browser the installer had not fetched. One version for both."
  },
  "overrides": {
    "playwright-core": "1.56.1"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.11.2",
    "@playwright/test": "1.56.1",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.8",
    "@types/node": "22.20.5",
    "@types/react": "18.3.31",
    "@types/react-dom": "18.3.7",
    "@vitejs/plugin-react": "4.7.0",
    "autoprefixer": "10.6.2",
    "jsdom": "25.0.1",
    "msw": "2.15.0",
    "openapi-typescript": "7.13.0",
    "postcss": "8.5.32",
    "tailwindcss": "3.4.19",
    "tailwindcss-animate": "1.0.7",
    "typescript": "5.9.3",
    "vite": "5.4.21",
    "vitest": "2.1.9"
  }
}

